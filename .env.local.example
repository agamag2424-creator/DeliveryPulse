# Database
# Local dev: run `npx prisma dev -d` then use the postgres:// URL it prints
DATABASE_URL=
DIRECT_URL=

# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Embeddings
OPENAI_API_KEY=

# Encryption
# 32-byte hex string for AES-256: openssl rand -hex 32
ENCRYPTION_KEY=

# Jira (populated per-user via OAuth — app credentials here)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=

# Asana — private OAuth app at https://app.asana.com/0/my-apps (no App Directory listing)
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
ASANA_REDIRECT_URI=

# Monday.com — share/publish from Developer Center; marketplace listing is optional
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
MONDAY_REDIRECT_URI=

# Trello — Power-Up admin API key at https://trello.com/apps/admin (do not submit a public Power-Up)
TRELLO_API_KEY=
# Optional. Auth return URL is built as {origin}/connectors/trello/complete
TRELLO_REDIRECT_URI=

# Email
RESEND_API_KEY=

# Already exists from Phase 1
ANTHROPIC_API_KEY=

# Optional AI provider/model overrides (defaults: Anthropic Claude Sonnet 4 + OpenAI text-embedding-3-small)
# See src/lib/ai/PROVIDERS.md
# AI_LLM_PROVIDER=anthropic
# AI_LLM_MODEL=claude-sonnet-4-6
# AI_EMBEDDING_PROVIDER=openai
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_GATEWAY_API_KEY=

# Development only — set to 'true' to skip auth checks locally. Never true in production.
AUTH_BYPASS=false

# Razorpay SaaS billing (org-level, USD). Key ID is public at checkout; secret stays server-only.
# Enable International Payments on the Razorpay dashboard for US/UK cards.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional. Created automatically on first checkout if omitted.
RAZORPAY_PLAN_ID=
